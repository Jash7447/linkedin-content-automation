# ---------------------------------------------------------------------------
# LinkedIn Content Workspace — environment variable template
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets. Only this *.example file is tracked.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1: auth, database, private storage) -------------------
# Public values — safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Full-access key — never expose to the client, never log.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (task-scoped keys to spread free-tier quota) ------------
# Server-only. Separate keys per task so one task cannot exhaust the other's
# daily quota. Obtain from Google AI Studio.
GEMINI_API_KEY_ANALYSIS=
GEMINI_API_KEY_DRAFTING=

# Optional. Overrides the Gemini model name. Defaults to "gemini-flash-latest".
# Set this if a model is deprecated/rotated on the free tier (changes often).
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Notes:
# - Not all variables are wired up yet; they are documented here as the
#   foundation is built out (see docs/ROADMAP.md "Required environment variables").
# - Keep server-only keys out of any NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------------------
