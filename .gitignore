# ---------------------------------------------------------------------------
# LinkedIn Content Workspace — .gitignore
# Keep secrets, local uploads, build output, and tooling noise out of git.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next.js build output
.next/
out/
build/
dist/
next-env.d.ts

# Production / misc build artifacts
*.tsbuildinfo

# Environment variables — NEVER commit real secrets.
# Only *.example files are tracked (see .env.local.example when added).
.env
.env.*
!.env.example
!.env.local.example

# Supabase local development
# (Supabase CLI writes local config, temp data, and logs here.)
.supabase/
supabase/.branches/
supabase/.temp/
supabase/.env

# Uploaded documents / user content — must never be committed.
# These are stored in private Supabase Storage, not in the repo.
uploads/
tmp/
*.pdf
*.xlsx
*.xls
!docs/**/*.pdf

# Testing / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Vercel
.vercel/

# TypeScript / tooling caches
.cache/
.turbo/
.eslintcache
